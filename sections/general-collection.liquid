<div style="background: {{ section.settings.pc__bg }}">
  <div class="container wrapper">
    <div class="pc__heading">
      <div class="content">
        <span class="pc__tag" style="color: {{ section.settings.label_color }}">
          {{- section.settings.section_label -}}
        </span>
        <h2 class="head__h2" style="color: {{ section.settings.heading_color }}">
          {{ section.settings.section_heading }}
        </h2>
      </div>
      <div class="link">
        <a href="{{ section.settings.button_link }}" style="color: {{ section.settings.button_color }};">
          {{- section.settings.button_text }}&nbsp;
          <span class="button__icon">
            <svg
              viewBox="-3.6 -10.1 43.2 43.2"
              version="1.1"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              fill="#000000"
              transform="rotate(0)"
            >
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round">
                </g>
                <g id="SVGRepo_iconCarrier">
                    <g id="icons" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                      <g id="ui-gambling-website-lined-icnos-casinoshunter" transform="translate(-212.000000, -159.000000)" fill="{{ section.settings.button_color }}" fill-rule="nonzero">
                        <g id="square-filled" transform="translate(50.000000, 120.000000)">
                          <path d="M187.108012,39.2902857 L197.649804,49.7417043 L197.708994,49.7959169 C197.889141,49.9745543 197.986143,50.2044182 198,50.4382227 L198,50.5617773 C197.986143,50.7955818 197.889141,51.0254457 197.708994,51.2040831 L197.6571,51.2479803 L187.108012,61.7097143 C186.717694,62.0967619 186.084865,62.0967619 185.694547,61.7097143 C185.30423,61.3226668 185.30423,60.6951387 185.694547,60.3080911 L194.702666,51.3738496 L162.99947,51.3746291 C162.447478,51.3746291 162,50.9308997 162,50.3835318 C162,49.8361639 162.447478,49.3924345 162.99947,49.3924345 L194.46779,49.3916551 L185.694547,40.6919089 C185.30423,40.3048613 185.30423,39.6773332 185.694547,39.2902857 C186.084865,38.9032381 186.717694,38.9032381 187.108012,39.2902857 Z M197.115357,50.382693 L186.401279,61.0089027 L197.002151,50.5002046 L197.002252,50.4963719 L196.943142,50.442585 L196.882737,50.382693 L197.115357,50.382693 Z" id="right-arrow">
                            </path>
                          </g>
                        </g>
                      </g>
                    </g>
            </svg></span
        ></a>
      </div>
    </div>
    <div class="pc__grid">
      {% assign selected_collection = section.settings.gen_collection %}

      {% for product in selected_collection.products %}
        <div class="pc__grid-item">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <div class="feature__img">
                <img
                  src="{{ product.featured_image | image_url: width: 1000 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                />
              </div>
            {% endif %}
            <div class="content">
              <h3>{{ product.title | escape }}</h3>
              {% assign description_words = product.description | strip_html | strip | split: ' ' %}
              <p>{{ description_words | slice: 0, 10 | join: ' ' }}...</p>
              <div class="card__meta">
                <span class="price">{{ product.price | money }}</span>
                <a href="{{ product.url }}" class="card__link">
                  <svg
                    viewBox="-3.6 -10.1 43.2 43.2"
                    version="1.1"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    fill="#000000"
                    transform="rotate(-45)"
                  >
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                      <g id="icons" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g id="ui-gambling-website-lined-icnos-casinoshunter" transform="translate(-212.000000, -159.000000)" fill="#252528" fill-rule="nonzero">
                          <g class="card_svg" id="square-filled" transform="translate(50.000000, 120.000000)">
                            <path d="M187.108012,39.2902857 L197.649804,49.7417043 L197.708994,49.7959169 C197.889141,49.9745543 197.986143,50.2044182 198,50.4382227 L198,50.5617773 C197.986143,50.7955818 197.889141,51.0254457 197.708994,51.2040831 L197.6571,51.2479803 L187.108012,61.7097143 C186.717694,62.0967619 186.084865,62.0967619 185.694547,61.7097143 C185.30423,61.3226668 185.30423,60.6951387 185.694547,60.3080911 L194.702666,51.3738496 L162.99947,51.3746291 C162.447478,51.3746291 162,50.9308997 162,50.3835318 C162,49.8361639 162.447478,49.3924345 162.99947,49.3924345 L194.46779,49.3916551 L185.694547,40.6919089 C185.30423,40.3048613 185.30423,39.6773332 185.694547,39.2902857 C186.084865,38.9032381 186.717694,38.9032381 187.108012,39.2902857 Z M197.115357,50.382693 L186.401279,61.0089027 L197.002151,50.5002046 L197.002252,50.4963719 L196.943142,50.442585 L196.882737,50.382693 L197.115357,50.382693 Z" id="right-arrow">
                              </path>
                            </g>
                          </g>
                        </g>
                      </g>
                  </svg>
                </a>
              </div>
            </div>
          </a>
        </div>
      {%- endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "pc__collection-sec",
  "settings": [
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "color",
      "id": "pc__bg",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "Curated Collections"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#000"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Shop by Wellness Needs"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Show all collections"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Choose collection"
    },
    {
      "type": "collection",
      "id": "gen_collection",
      "label": "Select collection"
    }
  ],
  "presets": [
    {
      "name": "General Collection",
      "category": "General"
    }
  ]
}
{% endschema %}
