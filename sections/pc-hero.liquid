{% if section.settings.enable_glow %}
  <div class="hero__glow hero__glow--top"></div>
  <div class="hero__glow hero__glow--bottom"></div>
{% endif %}
<div class="container">
  <div class="hero__grid">
    <div class="hero__content">
      {% if section.settings.show_badge and section.settings.badge_txt != blank %}
        <div class="hero__badge">
          <span>{{ section.settings.badge_txt | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading_txt != blank %}
        <h1 class="head__h1">{{ section.settings.heading_txt }}</h1>
      {% endif %}

      {% if section.settings.body_txt != blank %}
        <div class="desc">
          <p>{{ section.settings.body_txt | escape | newline_to_br }}</p>
        </div>
      {% endif %}

      <div class="hero__actions">
        {% if section.settings.dog_btn != blank %}
          <a
            href="{{ section.settings.dog_btn_link | default: routes.all_products_collection_url }}"
            class="hero__btn hero__btn--primary"
          >
            {{- section.settings.dog_btn | escape -}}
          </a>
        {% endif %}

        {% if section.settings.cat_btn != blank %}
          <a
            href="{{ section.settings.cat_btn_link | default: routes.all_products_collection_url }}"
            class="hero__btn hero__btn--secondary"
          >
            {{- section.settings.cat_btn | escape -}}
          </a>
        {% endif %}

        {% assign trust_points = section.blocks | where: 'type', 'trust' %}
        {% if trust_points.size > 0 %}
          <div class="hero__trust">
            {% for block in trust_points %}
              {% if block.settings.text != block or block.settings.highlight != blank %}
                <div class="hero__trust-item" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <span style="color: {{ block.settings.icon_color }};">
                      {{ block.settings.icon | escape }}
                    </span>
                  {% endif %}

                  <span class="hero__trust-text">
                    {% if block.settings.highlight != blank %}
                      <strong>{{ block.settings.highlight | escape }}</strong>
                    {% endif %}
                    {{ block.settings.trusts_desc | escape }}
                  </span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
    <div class="hero__visual">
      <div class="hero__img-wrap">
        <div class="hero__image-box">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                class: 'hero__image',
                loading: 'eager',
                fetchpriority: 'high',
                alt: section.settings.image_alt
            }}
          {% else %}
            <div class="hero__placeholder">
              <span>Add your hero image</span>
            </div>
          {% endif %}

          {% if section.settings.show_gradient %}
            <div class="hero__gradient"></div>
          {% endif %}

          {% if section.settings.show_vet %}
            <div class="hero__vet">
              <div class="hero__vet-icon">
                {{
                  section.settings.vet_icon_image
                  | image_url: width: 30, height: 30
                  | image_tag: alt: section.settings.vet_title
                }}
              </div>
              <div class="hero__vet-info">
                {% if section.settings.vet_title != blank %}
                  <h6>{{ section.settings.vet_title | escape }}</h6>
                {% endif %}
                {% if section.settings.vet_text != blank %}
                  <p>{{ section.settings.vet_text | escape }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if section.settings.show_review %}
            <div class="hero__review">
              {% if section.settings.avater != blank %}
                {{
                  section.settings.avater
                  | image_url: width: 120, height: 120
                  | image_tag: class: 'hero__avatar', loading: 'lazy', alt: section.settings.customer_name
                }}
              {% endif %}
              <div class="hero__review-info">
                <div class="hero__rating">
                  {% assign stars = section.settings.stars | plus: 0 %}
                  <div class="rating">
                    <div class="stars">
                      {% for star in (1..stars) %}
                        {{
                          section.settings.star
                          | image_url: width: 30, height: 30
                          | image_tag: alt: section.settings.vet_title, class: 'star__icon'
                        }}
                      {% endfor %}
                    </div>
                    {% if section.settings.stars != blank %}
                      <span class="hero__number">{{ section.settings.stars | escape }}</span>
                    {% endif %}
                  </div>

                  {% if section.settings.review_text != blank %}
                    <p>{{ section.settings.review_text | escape }}</p>
                  {% endif %}

                  {% if section.settings.customer_name != blank %}
                    <p class="customer">
                      {{ section.settings.customer_name | escape }}
                      <span>•</span>
                      {% if section.settings.verified != blank %}
                        {{ section.settings.verified | escape }}
                      {% endif %}
                    </p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "checkbox", "id": "enable_glow", "label": "Enable bg glow", "default": true },
    { "type": "header", "content": "Top Badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
    {
      "type": "text",
      "id": "badge_txt",
      "label": "Badge text",
      "default": "Holistic Pet Wellness • Vet Formulated Since 2019"
    },
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading_txt",
      "label": "Heading text",
      "default": "Nourish, Pamper & Protect Your Furry Best Friend"
    },
    { "type": "header", "content": "Body" },
    {
      "type": "text",
      "id": "body_txt",
      "label": "Body text",
      "default": "Vet-approved essentials, wholesome organic treats, and cozy lifestyle goods curated with unconditional love for conscious dog and cat parents."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "dog_btn", "label": "Button text", "default": "Shop Dogs" },
    { "type": "url", "id": "dog_btn_link", "label": "Button Link" },
    { "type": "text", "id": "cat_btn", "label": "Button text", "default": "Shop Cats" },
    { "type": "url", "id": "cat_btn_link", "label": "Button Link" },
    { "type": "header", "content": "Hero Image" },
    { "type": "image_picker", "id": "image", "label": "Main Image" },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Golden retriever dog and tabby cat sitting together in a warm sunlit living room"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show image gradient",
      "default": false
    },
    { "type": "header", "content": "Vaterinary Badge" },
    { "type": "checkbox", "id": "show_vet", "label": "Show veterinary badge", "default": true },
    { "type": "image_picker", "id": "vet_icon_image", "label": "Icon image" },
    { "type": "text", "id": "vet_title", "label": "Title", "default": "Clinical Standard" },
    { "type": "text", "id": "vet_text", "label": "Badge text", "default": "100% Vet Approved" },
    { "type": "header", "content": "Customer Review" },
    { "type": "checkbox", "id": "show_review", "label": "Show review card", "default": true },
    { "type": "image_picker", "id": "avater", "label": "Customer avater" },
    { "type": "image_picker", "id": "star", "label": "Star icon" },
    { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "No of stars", "default": 5 },
    { "type": "text", "id": "rating", "label": "Rating", "default": "5.0" },
    { "type": "text", "id": "review_text", "label": "Review text", "default": "Both Milo & Cleo thrive on PawCare!" },
    { "type": "text", "id": "customer_name", "label": "Customer Name", "default": "Emma W." },
    { "type": "text", "id": "verified", "label": "Verified Label", "default": "Verified Buyer" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust Point",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "eco"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlighted text"
        },
        {
          "type": "text",
          "id": "trusts_desc",
          "label": "Desciption",
          "default": "100% Non-Toxic & Clean"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Iocn color",
          "default": "#567D50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "General"
    }
  ]
}
{% endschema %}
