<header
  class="pc-header"
  style="background-color: {{ section.settings.header_bg }}"
>
  <div class="container wrapper">
    {% comment %} LOGO {% endcomment %}
    <div class="pc-logo">
      <a href="{{ routes.root_url }}">
        <img
          src="{{ section.settings.logo_img | image_url: width: section.settings.logo_width }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_height }}"
          style="
            width: {{ section.settings.logo_width }}px;
            height: {{ section.settings.logo_height }}px;
            object-fit: contain;
          "
        >
        <span>{{ shop.name }}</span>
      </a>
    </div>

    {% comment %} MENU {% endcomment %}
    <div class="pc-header__menu">
      <nav class="pc__nav" id="PCMenu" aria-label="Main Navigation">
        <ul class="pc__menu">
          {% for link in linklists['main-menu'].links %}
            <li class="pc__menu-item">
              <a
                href="{{ link.url }}"
                class="{% if link.active %}active{% endif %}"
                style="color: {{ section.settings.menu_item_color }}; font-size: {{ section.settings.menu_font_size }}px"
              >
                {{- link.title -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    {% comment %} ACTION {% endcomment %}
    <div class="pc-action">
      <div class="header-search">
        <form accept="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
          <svg
            viewBox="0 0 24 24"
            fill="transparent"
            xmlns="http://www.w3.org/2000/svg"
            width="{{ section.settings.search_icon_width }}"
            height="{{ section.settings.search_icon_height }}"
          >
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
                <g clip-path="url(#clip0_15_152)">
                    <rect width="24" height="24" fill="transparent"></rect>
                    <circle cx="10.5" cy="10.5" r="6.5" stroke="{{ section.settings.search_icon_color }}" stroke-linejoin="round"></circle>
                    <path d="M19.6464 20.3536C19.8417 20.5488 20.1583 20.5488 20.3536 20.3536C20.5488 20.1583 20.5488 19.8417 20.3536 19.6464L19.6464 20.3536ZM20.3536 19.6464L15.3536 14.6464L14.6464 15.3536L19.6464 20.3536L20.3536 19.6464Z" fill="{{ section.settings.search_icon_color }}"></path>
                </g>
                <defs>
                    <clipPath id="clip0_15_152">
                        <rect width="24" height="24" fill="white"></rect>
                    </clipPath>
                </defs>
            </g>
          </svg>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            class="header-search__input"
          />
        </form>
      </div>
      <div class="pc-user">
        <a href="{{ routes.account_url }}">
          <svg
            viewBox="0 0 16 16"
            fill="none"
            width="{{ section.settings.user_width }}"
            height="{{ section.settings.user_height }}"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
              <path d="M8 7C9.65685 7 11 5.65685 11 4C11 2.34315 9.65685 1 8 1C6.34315 1 5 2.34315 5 4C5 5.65685 6.34315 7 8 7Z" fill="#000000"></path>
              <path d="M14 12C14 10.3431 12.6569 9 11 9H5C3.34315 9 2 10.3431 2 12V15H14V12Z" fill="#000000"></path>
            </g>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header Background",
      "default": "#fdfbf7"
    },
    {
      "type": "image_picker",
      "id": "logo_img",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 10,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "search_icon_width",
      "label": "Search icon width",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "search_icon_height",
      "label": "Search icon height",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "svg_fill_color",
      "label": "SVG fill color",
      "default": "#fdfbf7"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search healthy treats, toys, beds..."
    },
    {
      "type": "color",
      "id": "search_icon_color",
      "label": "Search icon color",
      "default": "#012d1d"
    },
    {
      "type": "color",
      "id": "menu_item_color",
      "label": "Menu item color",
      "default": "#012d1d"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "label": "Menu font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "user_width",
      "label": "User icon width",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "user_height",
      "label": "User icon height",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
